FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-authoring.txt .
RUN python -m pip install --no-cache-dir --requirement requirements-authoring.txt

COPY authoring ./authoring

CMD ["uvicorn", "authoring.app:app", "--host", "0.0.0.0", "--port", "8000"]
